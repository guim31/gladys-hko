  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the Observatory",
        "fr": "Tester l’Observatoire",
        "de": "Observatorium testen",
        "es": "Probar el Observatorio"
      },
      "description": {
        "en": "Reads the current weather report and shows the temperature of the station nearest your house and the warnings in force.",
        "fr": "Lit le bulletin météo actuel et affiche la température de la station la plus proche de votre maison et les avertissements en vigueur.",
        "de": "Liest den aktuellen Wetterbericht und zeigt die Temperatur der Station, die deinem Zuhause am nächsten liegt, und die geltenden Warnungen.",
        "es": "Lee el parte meteorológico actual y muestra la temperatura de la estación más cercana a su vivienda y los avisos vigentes."
      },
      "timeout_seconds": 20
    }
  ],
